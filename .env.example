PORT=3000
DB_FILE=harmonize.db
APP_URL=http://localhost:3000
# Usuário inicial, criado na primeira execução se não houver usuários
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador
# NODE_ENV=production  (ativa cookie Secure e oculta o link de recuperação na resposta da API)

# Recuperação de senha por e-mail (SMTP). Sem SMTP_HOST nenhum e-mail é enviado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Harmonize <no-reply@exemplo.com>"
# Somente desenvolvimento: escreve o link de recuperação no log do servidor quando não há SMTP
DEV_LOG_RESET_LINKS=false
